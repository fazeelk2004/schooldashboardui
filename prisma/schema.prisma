generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg" // Or ERD.pdf, ERD.png
}


datasource db {
  provider = "postgresql"
}

model School {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  address     String?
  phone       String?
  email       String?
  website     String?
  img         String?
  description String?
  plan        Plan     @default(FREE)
  createdAt   DateTime @default(now())

  subscription     Subscription?
  admins           Admin[]
  teachers         Teacher[]
  students         Student[]
  parents          Parent[]
  grades           Grade[]
  classes          Class[]
  subjects         Subject[]
  lessons          Lesson[]
  exams            Exam[]
  assignments      Assignment[]
  events           Event[]
  announcements    Announcement[]
  quizzes          Quiz[]
  quizAssignments  QuizAssignment[]
  notifications    Notification[]
}

model Admin {
  id       String @id
  username String @unique

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String
  sex         UserSex
  createdAt   DateTime     @default(now())
  parentId    String?
  parent      Parent?       @relation(fields: [parentId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances     Attendance[]
  results         Result[]
  birthday        DateTime
  quizSubmissions QuizSubmission[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects        Subject[]
  lessons         Lesson[]
  classes         Class[]
  birthday        DateTime
  quizzes         Quiz[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Parent {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String    @unique
  address   String
  createdAt DateTime  @default(now())
  students  Student[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Grade {
  id    Int @id @default(autoincrement())
  level Int

  students Student[]
  classess Class[]
  exams       Exam[]
  assignments Assignment[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([level, schoolId])
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String
  capacity Int

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  lessons         Lesson[]
  students        Student[]
  gradeId         Int
  grade           Grade          @relation(fields: [gradeId], references: [id])
  events          Event[]
  announcements   Announcement[]
  quizAssignments QuizAssignment[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([name, schoolId])
}

model Subject {
  id       Int       @id @default(autoincrement())
  name     String
  teachers    Teacher[]
  lessons     Lesson[]
  exams       Exam[]
  assignments Assignment[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([name, schoolId])
}

model Lesson {
  id             Int       @id @default(autoincrement())
  name           String
  day            Day
  startTime      DateTime
  endTime        DateTime
  semesterStart  DateTime?
  semesterEnd    DateTime?

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  attendances Attendance[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Exam {
  id        Int      @id @default(autoincrement())
  title     String
  date      DateTime
  startTime DateTime
  endTime   DateTime

  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  gradeId   Int
  grade     Grade    @relation(fields: [gradeId], references: [id])
  results   Result[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Assignment {
  id      Int      @id @default(autoincrement())
  dueDate DateTime

  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  gradeId   Int
  grade     Grade    @relation(fields: [gradeId], references: [id])
  results   Result[]

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Result {
  id    Int @id @default(autoincrement())
  score Int

  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
}

model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  lessonId  Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id])

  @@unique([studentId, lessonId])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
}

model Quiz {
  id        Int      @id @default(autoincrement())
  title     String
  type      QuizType @default(MCQ)
  createdAt DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  questions       QuizQuestion[]
  quizAssignments QuizAssignment[]
}

model QuizQuestion {
  id         Int    @id @default(autoincrement())
  question   String
  options    Json   // Array of 4 strings for MCQ
  answer     String
  difficulty String

  quizId Int
  quiz   Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  studentAnswers QuizAnswer[]
}

model QuizAssignment {
  id      Int      @id @default(autoincrement())
  dueDate DateTime
  createdAt DateTime @default(now())

  quizId  Int
  quiz    Quiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  classId Int
  class   Class @relation(fields: [classId], references: [id])

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  submissions QuizSubmission[]
}

model QuizSubmission {
  id          Int      @id @default(autoincrement())
  score       Int
  totalMarks  Int
  submittedAt DateTime @default(now())

  quizAssignmentId Int
  quizAssignment   QuizAssignment @relation(fields: [quizAssignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  answers QuizAnswer[]

  @@unique([quizAssignmentId, studentId])
}

model QuizAnswer {
  id             Int    @id @default(autoincrement())
  studentAnswer  String

  quizSubmissionId Int
  quizSubmission   QuizSubmission @relation(fields: [quizSubmissionId], references: [id], onDelete: Cascade)

  quizQuestionId Int
  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      String
  title       String
  description String
  type        NotificationType
  link        String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Subscription {
  id                   Int                @id @default(autoincrement())
  schoolId             Int                @unique
  school               School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan                 Plan
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model PendingSignup {
  id        String   @id @default(cuid())
  plan      Plan
  payload   Json
  email     String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum Plan {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum NotificationType {
  ASSIGNMENT
  EXAM
  QUIZ
  STUDENT
  ANNOUNCEMENT
  GENERAL
}

enum QuizType {
  MCQ
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
